@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find dependencies
find_dependency(imgui REQUIRED)

# Include targets
include("${CMAKE_CURRENT_LIST_DIR}/RemoteDebuggerTargets.cmake")

# Set variables for users
set(RemoteDebugger_FOUND TRUE)
set(RemoteDebugger_VERSION @PROJECT_VERSION@)
set(RemoteDebugger_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_PREFIX@/include")

# Check if all required components are available
check_required_components(RemoteDebugger)